-- Candy2026 自動撿取 v11
-- v9 自動撿取 + 反掛機(融合 evxncodes anti-afk) + 計時器/FPS/Ping
-- ============================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local Stats = game:GetService("Stats")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")

-- ========== 設定 ==========
local TELEPORT_OFFSET_Y  = 2
local SCAN_INTERVAL      = 0.25
local COOLDOWN           = 0.15
local VISIT_TIMEOUT      = 3

-- 反掛機設定
local ANTI_IDLE_ENABLED  = true
local ANTI_IDLE_INTERVAL = 60      -- 每 60 秒主動觸發一次 (Roblox 預設 20 分鐘踢)

-- ========== 狀態 ==========
local running = false
local collectCount = 0
local lastScan = 0
local lastTp = 0
local visited = {}

-- 計時器
local startTime = nil
local elapsed = 0

-- 反掛機
local lastAntiIdle = 0
local antiIdleCount = 0

-- FPS 計算
local fpsFrameCount = 0
local fpsLastTime = tick()
local currentFPS = 0

-- Ping
local currentPing = 0

-- ========== Remote ==========
local candy = ReplicatedStorage:FindFirstChild("Candy2026")
local remote = candy and candy:FindFirstChild("Remote")
if not remote then warn("[AutoPick] ❌ 找不到 Remote"); return end
print("[AutoPick] ✅ Remote:", remote:GetFullName())

-- ============================================
-- 反掛機 (融合 evxncodes 的做法: CaptureController + ClickButton2)
-- ============================================
local function doAntiIdle()
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
    antiIdleCount += 1
    if _G.__updateAntiIdle then
        _G.__updateAntiIdle(antiIdleCount)
    end
    print(string.format("[AutoPick] 🛡 反掛機觸發 #%d", antiIdleCount))
end

-- 監聽 Roblox 原生 Idled 事件 (被判定掛機時觸發)
player.Idled:Connect(function()
    print("[AutoPick] ⚠ 被系統判定掛機, 觸發反制...")
    doAntiIdle()
    task.wait(1)
    doAntiIdle()
end)

