-- 全域更新函式
_G.__updateCount = function(n)
    countLabel.Text = "已傳送: " .. tostring(n)
end

_G.__updateTimer = function(str)
    timerLabel.Text = "⏱ 運行時間: " .. str
end

_G.__updateAntiIdle = function(n)
    antiIdleLabel.Text = string.format("🛡 反掛機: 已觸發 %d 次", n)
    antiIdleLabel.TextColor3 = Color3.fromRGB(120, 230, 120)
    task.delay(3, function()
        antiIdleLabel.TextColor3 = Color3.fromRGB(200, 200, 100)
    end)
end

_G.__updateFPS = function(fps)
    fpsLabel.Text = "FPS: " .. tostring(fps)
    -- 顏色根據 FPS 變化
    if fps >= 50 then
        fpsLabel.TextColor3 = Color3.fromRGB(120, 230, 120)
    elseif fps >= 30 then
        fpsLabel.TextColor3 = Color3.fromRGB(255, 220, 120)
    else
        fpsLabel.TextColor3 = Color3.fromRGB(255, 120, 120)
    end
end

-- 更新 Ping (每秒)
task.spawn(function()
    while true do
        task.wait(1)
        pingLabel.Text = "Ping: " .. tostring(currentPing) .. " ms"
        if currentPing <= 80 then
            pingLabel.TextColor3 = Color3.fromRGB(120, 230, 120)
        elseif currentPing <= 150 then
            pingLabel.TextColor3 = Color3.fromRGB(255, 220, 120)
        else
            pingLabel.TextColor3 = Color3.fromRGB(255, 120, 120)
        end
    end
end)

