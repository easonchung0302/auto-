-- ============================================
-- 工具函式
-- ============================================
local function getPos(obj)
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        local p = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        return p and p.Position or nil
    end
    return nil
end

local function teleportTo(pos)
    if not rootPart or not rootPart.Parent then
        character = player.Character
        if not character then return false end
        rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return false end
    end

    local now = os.clock()
    if now - lastTp < COOLDOWN then return false end
    lastTp = now

    rootPart.CFrame = CFrame.new(pos + Vector3.new(0, TELEPORT_OFFSET_Y, 0))
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    return true
end

local function formatTime(sec)
    sec = math.floor(sec)
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    local s = sec % 60
    return string.format("%02d:%02d:%02d", h, m, s)
end

-- ============================================
-- 主循環
-- ============================================
RunService.Heartbeat:Connect(function()
    -- FPS 計算
    fpsFrameCount += 1
    local now = tick()
    if now - fpsLastTime >= 1 then
        currentFPS = fpsFrameCount
        fpsFrameCount = 0
        fpsLastTime = now
        if _G.__updateFPS then _G.__updateFPS(currentFPS) end
    end

    -- Ping (每秒更新)
    pcall(function()
        local ps = Stats:FindFirstChild("PerformanceStats")
        if ps and ps:FindFirstChild("Ping") then
            currentPing = math.floor(tonumber(ps.Ping:GetValue()) or 0)
        end
    end)

    if not running then return end
    now = os.clock()

    -- 更新運行時間
    if startTime then
        elapsed = now - startTime
        if _G.__updateTimer then _G.__updateTimer(formatTime(elapsed)) end
    end

    -- 反掛機定時觸發 (主動)
    if ANTI_IDLE_ENABLED and (now - lastAntiIdle) >= ANTI_IDLE_INTERVAL then
        lastAntiIdle = now
        doAntiIdle()
    end

    -- 掃描 & 傳送
    if now - lastScan < SCAN_INTERVAL then return end
    lastScan = now

    if not rootPart or not rootPart.Parent then
        rootPart = character and character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
    end

    if not candyFolder or not candyFolder.Parent then
        candyFolder = getCandyFolder()
        if not candyFolder then return end
    end

    local myPos = rootPart.Position
    local closest, closestDist, closestName = nil, math.huge, nil

    for _, obj in ipairs(candyFolder:GetChildren()) do
        if obj:IsA("Model") then
            local pos = getPos(obj)
            if pos then
                local d = (pos - myPos).Magnitude
                if d < closestDist then
                    closest, closestDist, closestName = pos, d, obj.Name
                end
            end
        end
    end

    if closest then
        local key = string.format("%.0f_%.0f_%.0f", closest.X, closest.Y, closest.Z)
        local lastVisit = visited[key]
        if lastVisit and (now - lastVisit) < VISIT_TIMEOUT then
            return
        end

        if teleportTo(closest) then
            visited[key] = now
            collectCount += 1
            if _G.__updateCount then _G.__updateCount(collectCount) end
            print(string.format("[AutoPick] 🚀 傳送 #%d → %s (距離 %.1f)",
                collectCount, closestName, closestDist))
        end
    end
end)

-- ============================================
-- 監聽事件 (清 visited 表示有新糖果)
-- ============================================
remote.OnClientEvent:Connect(function(...)
    local args = {...}
    if args[1] == "Add" then
        visited = {}
        print("[AutoPick] ✨ Add → 清空 visited")
    end
end)

-- ============================================
-- 控制
-- ============================================
local function startAuto()
    running = true
    collectCount = 0
    visited = {}
    startTime = os.clock()
    lastAntiIdle = os.clock()
    antiIdleCount = 0
    print("[AutoPick] ▶ 已啟動 (計時開始)")
end

local function stopAuto()
    running = false
    print(string.format("[AutoPick] ⛔ 已停止 (運行 %s)", formatTime(elapsed)))
end

